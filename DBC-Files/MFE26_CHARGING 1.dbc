CM_ BO_ 1 "TX 100 ms. Booleans + charge state only; analogs live in BMS_PACK.";
CM_ BO_ 2 "TX 250 ms. Pack analogs, means over the 250 ms window.";
CM_ BO_ 15 "TX 250 ms. MIN/MAX are 250 ms peak-hold of per-scan extremes (transients visible); AVG is the 250 ms mean of all cell samples.";
CM_ BO_ 16 "TX 100 ms. Latched fault register + comms health.";
CM_ BO_ 17 "TX 250 ms. Pack thermistor stats over the 250 ms window.";
CM_ SG_ 16 FAULT_BITS "bit0 CELL_OV, bit1 CELL_UV, bit2 CELL_OT, bit3 CHAIN_COMMS, bit4 SCAN_STALE, bit5 INIT_FAIL, bit6 IMD, bit7 CURRENT_SENSOR, bit8 CHARGER, bit9 CELL_IMPLAUSIBLE";
CM_ SG_ 16 RESET_CAUSE "bit0 IWDG, bit1 pin, bit2 BOR, bit3 software, bit4 WWDG, bit5 low-power";
CM_ SG_ 16 SCAN_AGE "Age of newest successful cell-voltage scan. 255 = >2.55 s or never.";
CM_ SG_ 16 CAN_TX_FAIL_COUNT "Frames lost while the bus was healthy. Bus-off periods do not count (see BUS_OFF).";
CM_ "Per-module stats (BMS_Mn_VOLT 0x100+n, BMS_Mn_TEMP 0x110+n) TX 500 ms: min/max/avg over the 500 ms per-cell means, plus the cell/thermistor index (0-based) of the min and max. Index 255 = no valid channel. Raw per-cell values are available on the UART console only. Charger IDs 0x610/0x611/0x614/0x615/0x618 are the EVO proprietary protocol and intentionally not in this file.";

CM_ BO_ 1560 "BMS -> charger control, TX 100 ms DLC 7. Charger drops output if absent >600 ms (see CHG_Tst1.Rx618Fail). CanEnable + charger interlock = charging enabled.";
CM_ BO_ 1552 "Charger status flags, TX 1 s.";
CM_ BO_ 1553 "Charger actual values, TX 100 ms. TempPowerStage = raw*0.005188-40.";
CM_ BO_ 1556 "Charger power/AC limits, TX 1 s. Prox/Pilot limits only meaningful with EN61851/J1772.";
CM_ BO_ 1557 "Charger diagnostics, TX 100 ms. Rx618Fail=1 means OUR CtL stream stopped reaching it.";

VAL_ 1 CHARGE_STATE 0 "INACTIVE" 1 "NO_COMMS" 2 "FAST" 3 "RAMP_DOWN" 4 "IDLE" 5 "FAULT" ;







