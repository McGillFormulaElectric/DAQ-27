VAL_TABLE_ Err_Internal_Fault 1 "internal inverter fault" 0 "no error" ;
VAL_TABLE_ Err_Overtemperature 1 "overtemperature motor/inverter" 0 "no error" ;
VAL_TABLE_ Err_ControlError 1 "control error current controller" 0 "no error" ;
VAL_TABLE_ Err_Overspeed 1 "speed limit has been exceeded" 0 "no error" ;
VAL_TABLE_ Err_Short_Circuit 1 "desat protection has triggered" 0 "no error" ;
VAL_TABLE_ Err_Overcurrent 1 "overcurrent occured in a phase" 0 "no error" ;
VAL_TABLE_ Err_Position_Sensor 1 "Error position sensor" 0 "no error" ;
VAL_TABLE_ Err_Sum_Phase_Currents 1 "Sum phase currents implausible" 0 "no error" ;
VAL_TABLE_ Err_Disable_Under_Load 1 "Received enable low under load" 0 "no error" ;
VAL_TABLE_ Err_Timeout_Communication 1 "Timeout of communication" 0 "no error" ;
VAL_TABLE_ Err_Motortemperature 1 "motor temp measurement faulty" 0 "no error" ;
VAL_TABLE_ Err_DC_Undervoltage 1 "undervoltage occured" 0 "no error" ;
VAL_TABLE_ Err_DC_Overvoltage 1 "overvoltage occured (>700V)" 0 "no error" ;
VAL_TABLE_ Err_LV_Supply 1 "supply insufficient" 0 "no error" ;
VAL_TABLE_ Err_ControlDisabled 1 "Enable low or Disable high" 0 "no error" ;
VAL_TABLE_ AckErr 1 "Reset errorbits on rising edge" 0 "Errorbits remain latched" ;
VAL_TABLE_ MirrorControlDisable 1 "Control disabled" 0 "Condition fulfilled" ;
VAL_TABLE_ MirrorControlEnable 1 "Condition fulfilled" 0 "Control Disabled" ;
VAL_TABLE_ DClinkGoodFront 1 "DC-Link voltage good for inv3+4" 0 "DC-Link voltage low for inv3+4" ;
VAL_TABLE_ DClinkGoodRear 1 "DC-Link voltage good for inv1+2" 0 "DC-Link voltage low for inv1+2" ;
VAL_TABLE_ DeratingIndication 1 "'Is-Max' is limited" 0 "'Is-Max' is not limited" ;
VAL_TABLE_ InverterReady 1 "Ready" 0 "NotReady" ;
VAL_TABLE_ InverterState 3 "Config values missing" 2 "Error" 1 "Drive" 0 "Idle" ;
VAL_TABLE_ CurrentControl 1 "Current control" 0 "Speed or torque control" ;
VAL_TABLE_ ASCallowed 1 "allowed" 0 "not allowed" ;
VAL_TABLE_ ResetError 1 "reset error" 0 "-" ;
VAL_TABLE_ EnableInverter 1 "enable control" 0 "disable control" ;


